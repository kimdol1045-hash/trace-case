# Copy to an untracked .env file or inject these values from your secret store.
TC_ENVIRONMENT=local
TC_DATABASE_URL=postgresql+psycopg://tc:replace-me@127.0.0.1:5432/tc
TC_ENCRYPTION_MASTER_KEY=replace-with-at-least-32-random-characters

# External integrations are disabled for local backend-only development.
TC_SLACK_MODE=disabled
TC_SLACK_ALLOWLIST_CHANNEL_IDS=[]
TC_SLACK_RECENT_RESYNC_LOOKBACK_DAYS=7
TC_SLACK_RECENT_RESYNC_INTERVAL_SECONDS=3600

TC_OLLAMA_BASE_URL=http://127.0.0.1:11434
TC_GENERATION_MODEL=qwen3:8b
TC_EMBEDDING_MODEL=bge-m3
TC_EMBEDDING_DIMENSION=1024
TC_LIGHT_RAG_WORKSPACE=tc

# Versioned LightRAG generation routing is separately disabled. Enable only
# after every commented value is supplied by the approved deployment config;
# the PostgreSQL password must come from a secret store.
TC_LIGHT_RAG_ENABLED=false
TC_LIGHT_RAG_APACHE_AGE_AVAILABLE=false
# TC_LIGHT_RAG_AUTHORITY_ID=replace-with-approved-auxiliary-authority
# TC_LIGHT_RAG_AUXILIARY_TARGET_DIGEST=sha256:replace-with-64-lowercase-hex
# TC_LIGHT_RAG_PROVIDER_ID=official-lightrag-postgresql
# TC_LIGHT_RAG_POSTGRES_HOST=replace-with-auxiliary-postgres-host
# TC_LIGHT_RAG_POSTGRES_PORT=5432
# TC_LIGHT_RAG_POSTGRES_USER=replace-with-generation-role
# TC_LIGHT_RAG_POSTGRES_PASSWORD=replace-with-secret-store-value
# TC_LIGHT_RAG_POSTGRES_DATABASE=replace-with-auxiliary-database
# TC_LIGHT_RAG_POSTGRES_MAX_CONNECTIONS=12
# TC_LIGHT_RAG_POSTGRES_SSL_MODE=verify-full
# TC_LIGHT_RAG_RUNTIME_BOOTSTRAP=approved.module:build_runtime
# TC_LIGHT_RAG_WORKING_DIRECTORY_ROOT=/var/lib/tc/lightrag-runtimes

# Slack-to-knowledge projection is a separate opt-in from both Slack ingestion
# and automatic generation. Disabled is the zero-provider-call default.
TC_AUTOMATIC_KNOWLEDGE_PROJECTION_ENABLED=false
TC_KNOWLEDGE_EXTRACTION_TIMEOUT_SECONDS=60
TC_KNOWLEDGE_EXTRACTION_RESPONSE_MAX_BYTES=1048576

# T07 durable automatic generation provider. Disabled is the zero-network
# default. Enable only after all values are injected from the secret store.
TC_AUTOMATIC_GENERATION_ENABLED=false
TC_AUTOMATIC_GENERATION_PROVIDER_ID=replace-with-approved-provider
TC_AUTOMATIC_GENERATION_PROVIDER_ENDPOINT=https://generation.example.com/v1/generate
TC_AUTOMATIC_GENERATION_PROVIDER_MODEL_ID=replace-with-approved-model-version
TC_AUTOMATIC_GENERATION_PROVIDER_AUTH_TOKEN=replace-with-secret-store-value
TC_AUTOMATIC_GENERATION_PROVIDER_AUTH_HEADER=Authorization
TC_AUTOMATIC_GENERATION_PROVIDER_AUTH_SCHEME=Bearer
TC_AUTOMATIC_GENERATION_PROVIDER_TIMEOUT_SECONDS=60
TC_AUTOMATIC_GENERATION_PROVIDER_RESPONSE_MAX_BYTES=1048576

# T08 no-login review authority. Provision raw reviewer tokens out of band and
# configure only their `sha256:<lowercase hex>` hashes. The two JSON arrays are
# ordinal pairs and must contain at least two distinct entries when enabled.
TC_QUALITY_REVIEWER_PRINCIPALS=[]
TC_QUALITY_REVIEWER_TOKEN_HASHES=[]
TC_QUALITY_REVIEW_SOURCE_SEAL_KEY=replace-with-separate-at-least-32-character-secret
TC_QUALITY_REVIEW_SOURCE_SEAL_KEY_ID=quality-review-source-v1

# Private attachments. Production uses the Cloudflare R2 S3 API endpoint.
# Local `pnpm dev` supplies equivalent MinIO defaults automatically.
TC_OBJECT_STORAGE_ENABLED=false
TC_OBJECT_STORAGE_PROVIDER=R2
TC_OBJECT_STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
TC_OBJECT_STORAGE_BROWSER_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
TC_OBJECT_STORAGE_BUCKET=tc-attachments
TC_OBJECT_STORAGE_REGION=auto
TC_OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key-id
TC_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
TC_OBJECT_STORAGE_PRESIGN_TTL_SECONDS=300
TC_OBJECT_STORAGE_MAX_FILE_BYTES=52428800
TC_OBJECT_STORAGE_CLAMAV_HOST=127.0.0.1
TC_OBJECT_STORAGE_CLAMAV_PORT=53310
TC_OBJECT_STORAGE_CLAMAV_TIMEOUT_SECONDS=30
# Budgets drive the 70/85/95 warnings. Set current approved R2 rates explicitly;
# zero rates keep cost estimates disabled without inventing vendor pricing.
TC_OBJECT_STORAGE_STORAGE_BUDGET_BYTES=10737418240
TC_OBJECT_STORAGE_CLASS_A_REQUEST_BUDGET=1000000
TC_OBJECT_STORAGE_CLASS_B_REQUEST_BUDGET=10000000
TC_OBJECT_STORAGE_STORAGE_USD_PER_GB_MONTH=0
TC_OBJECT_STORAGE_CLASS_A_USD_PER_MILLION=0
TC_OBJECT_STORAGE_CLASS_B_USD_PER_MILLION=0

TC_JOB_MAX_ATTEMPTS=5
TC_JOB_RETRY_BASE_SECONDS=5
TC_JOB_RETRY_MAX_SECONDS=3600
TC_JOB_STALE_AFTER_SECONDS=300
