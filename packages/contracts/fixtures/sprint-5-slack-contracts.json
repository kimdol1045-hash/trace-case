{
  "synthetic": true,
  "description": "Synthetic Sprint 5 Slack ingress, ledger, access, revision, parsing, synchronization and job examples only. No production workspace, channel, message or credential data is present.",
  "cases": [
    {
      "name": "Slack URL verification request accepts the exact ingress wire",
      "schemaRef": "https://qa-tool.local/schemas/sprint-5/slack-event-api.schema.json#/$defs/SlackUrlVerificationRequest",
      "expectedValid": true,
      "payload": {
        "token": "synthetic-ingress-verification-value",
        "challenge": "synthetic-challenge-001",
        "type": "url_verification"
      }
    },
    {
      "name": "URL verification response rejects every non-challenge field",
      "schemaRef": "https://qa-tool.local/schemas/sprint-5/slack-event-api.schema.json#/$defs/SlackUrlVerificationResponse",
      "expectedValid": false,
      "payload": {
        "challenge": "synthetic-challenge-001",
        "unexpectedField": "forbidden-response-field"
      }
    },
    {
      "name": "HTTP verification records bounded timestamp skew without raw authentication material",
      "schemaRef": "https://qa-tool.local/schemas/sprint-5/slack-event-api.schema.json#/$defs/SlackHttpVerificationResult",
      "expectedValid": true,
      "payload": {
        "authenticated": true,
        "signatureVersion": "v0",
        "requestTimestamp": 1787270400,
        "receivedAt": "2026-08-21T00:00:03Z",
        "timestampSkewSeconds": 3,
        "maximumSkewSeconds": 300
      }
    },
    {
      "name": "HTTP verification rejects requests older than five minutes",
      "schemaRef": "https://qa-tool.local/schemas/sprint-5/slack-event-api.schema.json#/$defs/SlackHttpVerificationResult",
      "expectedValid": false,
      "payload": {
        "authenticated": true,
        "signatureVersion": "v0",
        "requestTimestamp": 1787270000,
        "receivedAt": "2026-08-21T00:06:00Z",
        "timestampSkewSeconds": 360,
        "maximumSkewSeconds": 300
      }
    },
