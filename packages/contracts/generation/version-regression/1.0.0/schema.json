                  "datasetKind": {"const": "SYNTHETIC_FIXTURE"},
                  "releaseCertified": {"const": false}
                },
                "required": ["datasetKind", "releaseCertified"]
              },
              "newGoldenReport": {
                "type": "object",
                "properties": {
                  "datasetKind": {"const": "SYNTHETIC_FIXTURE"},
                  "releaseCertified": {"const": false}
                },
                "required": ["datasetKind", "releaseCertified"]
              },
              "liveAttestation": {
                "type": "object",
                "properties": {"status": {"const": "NOT_RUN"}},
                "required": ["status"]
              }
            }
          }
        }
      ]
