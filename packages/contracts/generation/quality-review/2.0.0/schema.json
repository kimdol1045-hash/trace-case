{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qa-tool.local/schemas/generation/quality-review/2.0.0/schema.json",
  "title": "Automatic generation quality review safe API 2.0.0",
  "description": "E4-envelope-only requests and public projections. Legacy snapshot/hash/alias DTOs are not accepted.",
  "oneOf": [
    {"$ref": "#/$defs/ImportRequest"},
    {"$ref": "#/$defs/DecisionRequest"},
    {"$ref": "#/$defs/Candidate"},
    {"$ref": "#/$defs/CandidatePage"},
    {"$ref": "#/$defs/ReviewedExport"}
  ],
  "$defs": {
    "Digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "Seal": {"type": "string", "pattern": "^hmac-sha256:[a-f0-9]{64}$"},
    "CandidateKey": {"type": "string", "pattern": "^review-candidate:[a-f0-9]{64}$"},
    "IdempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ReasonCode": {
      "enum": [
        "QUALITY_EVIDENCE_INSUFFICIENT",
        "PRIVACY_FENCE_FAILED",
        "SOURCE_DRIFT",
        "TAMPER_DETECTED",
        "OTHER_POLICY_FAILURE"
      ]
    },
    "ImportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "rootJobIds", "captureEnvironment", "reportOutputs"],
      "properties": {
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "rootJobIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uuid"}
        },
        "captureEnvironment": {"enum": ["staging", "production"]},
        "reportOutputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["json", "junit", "markdown"],
          "properties": {
            "json": {"type": "string", "minLength": 1},
            "junit": {"type": "string", "minLength": 1},
            "markdown": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "DecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "decision", "expectedArtifactFingerprint", "reasonCode"],
      "properties": {
        "idempotencyKey": {"$ref": "#/$defs/IdempotencyKey"},
        "decision": {"enum": ["APPROVE", "REJECT"]},
        "expectedArtifactFingerprint": {"$ref": "#/$defs/Digest"},
        "reasonCode": {"oneOf": [{"$ref": "#/$defs/ReasonCode"}, {"type": "null"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "APPROVE"}}, "required": ["decision"]},
          "then": {"properties": {"reasonCode": {"type": "null"}}}
        },
        {
          "if": {"properties": {"decision": {"const": "REJECT"}}, "required": ["decision"]},
          "then": {"properties": {"reasonCode": {"$ref": "#/$defs/ReasonCode"}}}
        }
      ]
    },
    "Counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationRoots", "generationJobs", "generationResults", "generatedCases", "generatedSteps", "evidenceReferences"],
      "properties": {
        "generationRoots": {"type": "integer", "minimum": 1},
        "generationJobs": {"type": "integer", "minimum": 1},
        "generationResults": {"type": "integer", "minimum": 1},
        "generatedCases": {"type": "integer", "minimum": 0},
        "generatedSteps": {"type": "integer", "minimum": 0},
        "evidenceReferences": {"type": "integer", "minimum": 0}
      }
    },
    "ClassificationDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GROUNDED_ACTIVE", "SUPERSEDED_TRAP", "RETRACTED_TRAP", "DELETED_TRAP", "REJECTED_TRAP", "UNAVAILABLE_TRAP", "UNRESOLVED_CONFLICT", "DECISION_CANDIDATE", "EXACT_DUPLICATE_TRAP", "SEMANTIC_DUPLICATE_TRAP", "CATEGORY_COLLISION_TRAP", "PARENT_COLLISION_TRAP", "CASE_ORDERING", "BLANK_OR_INVALID_RESULT", "APPLY_PROVENANCE", "SUGGESTION_PROVENANCE"],
      "properties": {
        "GROUNDED_ACTIVE": {"type": "integer", "minimum": 0},
        "SUPERSEDED_TRAP": {"type": "integer", "minimum": 0},
        "RETRACTED_TRAP": {"type": "integer", "minimum": 0},
        "DELETED_TRAP": {"type": "integer", "minimum": 0},
        "REJECTED_TRAP": {"type": "integer", "minimum": 0},
        "UNAVAILABLE_TRAP": {"type": "integer", "minimum": 0},
        "UNRESOLVED_CONFLICT": {"type": "integer", "minimum": 0},
        "DECISION_CANDIDATE": {"type": "integer", "minimum": 0},
        "EXACT_DUPLICATE_TRAP": {"type": "integer", "minimum": 0},
        "SEMANTIC_DUPLICATE_TRAP": {"type": "integer", "minimum": 0},
        "CATEGORY_COLLISION_TRAP": {"type": "integer", "minimum": 0},
        "PARENT_COLLISION_TRAP": {"type": "integer", "minimum": 0},
        "CASE_ORDERING": {"type": "integer", "minimum": 0},
        "BLANK_OR_INVALID_RESULT": {"type": "integer", "minimum": 0},
        "APPLY_PROVENANCE": {"type": "integer", "minimum": 0},
        "SUGGESTION_PROVENANCE": {"type": "integer", "minimum": 0}
      }
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sealAlgorithm", "keyId", "privacyDomain", "fieldSeals"],
      "properties": {
        "sealAlgorithm": {"const": "HMAC-SHA-256"},
        "keyId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
        "privacyDomain": {"const": "generation-quality-review"},
        "fieldSeals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "allOf": [
            {"contains": {"type": "object", "properties": {"fieldDomain": {"const": "operational-root-set"}}, "required": ["fieldDomain"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"fieldDomain": {"const": "private-t08-snapshot"}}, "required": ["fieldDomain"]}, "minContains": 1, "maxContains": 1}
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fieldDomain", "seal"],
            "properties": {
              "fieldDomain": {"enum": ["operational-root-set", "private-t08-snapshot"]},
              "seal": {"$ref": "#/$defs/Seal"}
            }
          }
        }
      }
    },
    "Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "status", "reviewable", "materialization", "createdAt", "capturedAt", "captureEnvironment", "captureRevision", "fingerprints", "source", "privacy", "envelopeContractVersion", "payloadSchemaVersion", "counts", "classificationDistribution", "progress", "decisions", "approval", "certificationStatus", "releaseCertified"],
      "properties": {
        "candidateId": {"$ref": "#/$defs/CandidateKey"},
        "status": {"enum": ["UNREVIEWED", "PENDING_APPROVAL", "APPROVED", "REJECTED"]},
        "reviewable": {"type": "boolean"},
        "materialization": {"const": "COMPLETE"},
        "createdAt": {"type": "string", "format": "date-time"},
        "capturedAt": {"type": "string", "format": "date-time"},
        "captureEnvironment": {"enum": ["staging", "production"]},
        "captureRevision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
        "fingerprints": {
          "type": "object", "additionalProperties": false,
          "required": ["payloadFingerprint", "artifactFingerprint"],
          "properties": {"payloadFingerprint": {"$ref": "#/$defs/Digest"}, "artifactFingerprint": {"$ref": "#/$defs/Digest"}}
        },
        "source": {"$ref": "#/$defs/Source"},
        "privacy": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "policyVersion", "foundationPolicyVersion", "normalizationVersion", "mode", "redactionCount", "findingCategories", "containsRawSourceText"],
          "properties": {
            "status": {"const": "CLEAN"},
            "policyVersion": {"const": "review-candidate-sensitive-data-v1"},
            "foundationPolicyVersion": {"const": "review-candidate-sensitive-data-v1"},
            "normalizationVersion": {"const": "review-candidate-nfkc-lf-ignorables-v1"},
            "mode": {"const": "REJECT"},
            "redactionCount": {"const": 0},
            "findingCategories": {"type": "array", "maxItems": 0},
            "containsRawSourceText": {"const": false}
          }
        },
        "envelopeContractVersion": {"const": "review-candidate-envelope/1.0.0"},
        "payloadSchemaVersion": {"const": "generation-quality-review-projection-v2"},
        "counts": {"$ref": "#/$defs/Counts"},
        "classificationDistribution": {"$ref": "#/$defs/ClassificationDistribution"},
        "progress": {
          "type": "object", "additionalProperties": false,
          "required": ["approveCount", "requiredApproveCount", "rejected"],
          "properties": {"approveCount": {"type": "integer", "minimum": 0, "maximum": 2}, "requiredApproveCount": {"const": 2}, "rejected": {"type": "boolean"}}
        },
        "decisions": {
          "type": "array", "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["reviewerSlot", "reviewerSeal", "decision", "reasonCode", "decisionFingerprint", "observedArtifactFingerprint", "decidedAt"],
            "properties": {
              "reviewerSlot": {"type": "integer", "minimum": 1, "maximum": 2},
              "reviewerSeal": {"$ref": "#/$defs/Seal"},
              "decision": {"enum": ["APPROVE", "REJECT"]},
              "reasonCode": {"oneOf": [{"$ref": "#/$defs/ReasonCode"}, {"type": "null"}]},
              "decisionFingerprint": {"$ref": "#/$defs/Digest"},
              "observedArtifactFingerprint": {"$ref": "#/$defs/Digest"},
              "decidedAt": {"type": "string", "format": "date-time"}
            }
          }
        },
        "approval": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false,
              "required": ["reviewAuthorityFingerprint", "approvalArtifactFingerprint", "approvedAt"],
              "properties": {"reviewAuthorityFingerprint": {"$ref": "#/$defs/Digest"}, "approvalArtifactFingerprint": {"$ref": "#/$defs/Digest"}, "approvedAt": {"type": "string", "format": "date-time"}}
            },
            {"type": "null"}
          ]
        },
        "certificationStatus": {"enum": ["NOT_REVIEWED", "REVIEWED_NOT_RELEASE_CERTIFIED"]},
        "releaseCertified": {"const": false}
      }
    },
    "CandidatePage": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "nextCursor"],
      "properties": {"items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/Candidate"}}, "nextCursor": {"oneOf": [{"$ref": "#/$defs/CandidateKey"}, {"type": "null"}]}}
    },
    "ReviewedExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKind", "contractVersion", "candidateKey", "baseEnvelope", "review", "attestation", "certification"],
      "properties": {
        "artifactKind": {"const": "AUTOMATIC_GENERATION_QUALITY_REVIEWED_EXPORT"},
        "contractVersion": {"const": "automatic-generation-quality-reviewed-export/2.0.0"},
        "candidateKey": {"$ref": "#/$defs/CandidateKey"},
        "baseEnvelope": {
          "allOf": [
            {"$ref": "https://qa-tool.local/schemas/review-candidate/1.0.0/schema.json"},
            {
              "type": "object",
              "properties": {
                "purpose": {"const": "Operational generation quality review"},
                "dataClass": {"const": "ACTUAL_MINIMIZED"},
                "candidate": {
                  "type": "object",
                  "properties": {
                    "revision": {"const": 1},
                    "predecessorArtifactFingerprint": {"type": "null"}
                  },
                  "required": ["revision", "predecessorArtifactFingerprint"]
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "privacyDomain": {"const": "generation-quality-review"},
                    "synthetic": {"const": false},
                    "fieldSeals": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "allOf": [
                        {"contains": {"type": "object", "properties": {"fieldDomain": {"const": "operational-root-set"}}, "required": ["fieldDomain"]}, "minContains": 1, "maxContains": 1},
                        {"contains": {"type": "object", "properties": {"fieldDomain": {"const": "private-t08-snapshot"}}, "required": ["fieldDomain"]}, "minContains": 1, "maxContains": 1}
                      ]
                    }
                  },
                  "required": ["privacyDomain", "synthetic", "fieldSeals"]
                },
                "sanitization": {
                  "type": "object",
                  "properties": {"mode": {"const": "REJECT"}, "status": {"const": "CLEAN"}, "redactionCount": {"const": 0}, "findingCategories": {"type": "array", "maxItems": 0}},
                  "required": ["mode", "status", "redactionCount", "findingCategories"]
                },
                "sampling": {"type": "object", "properties": {"strategy": {"const": "ALL"}}, "required": ["strategy"]},
                "payload": {"type": "object", "properties": {"schemaVersion": {"const": "generation-quality-review-projection-v2"}}, "required": ["schemaVersion"]},
                "review": {"type": "object", "properties": {"status": {"const": "UNREVIEWED"}}, "required": ["status"]},
                "attestation": {"type": "object", "properties": {"status": {"const": "NOT_RUN"}}, "required": ["status"]},
                "certification": {"type": "object", "properties": {"status": {"const": "NOT_CERTIFIED"}, "eligible": {"const": false}}, "required": ["status", "eligible"]}
              },
              "required": ["purpose", "dataClass", "candidate", "source", "sanitization", "sampling", "payload", "review", "attestation", "certification"]
            }
          ]
        },
        "review": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reviewedAt", "requiredApprovals", "reviewerAuthoritySeals", "decisionFingerprints", "reviewAuthorityFingerprint", "approvalArtifactFingerprint", "approvedAt"],
          "properties": {
            "status": {"const": "REVIEWED"},
            "reviewedAt": {"type": "string", "format": "date-time"},
            "requiredApprovals": {"const": 2},
            "reviewerAuthoritySeals": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/Seal"}},
            "decisionFingerprints": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/Digest"}},
            "reviewAuthorityFingerprint": {"$ref": "#/$defs/Digest"},
            "approvalArtifactFingerprint": {"$ref": "#/$defs/Digest"},
            "approvedAt": {"type": "string", "format": "date-time"}
          }
        },
        "attestation": {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "NOT_RUN"}}},
        "certification": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "eligible", "releaseCertified", "limitations"],
          "properties": {
            "status": {"const": "REVIEWED_NOT_RELEASE_CERTIFIED"},
            "eligible": {"const": false},
            "releaseCertified": {"const": false},
            "limitations": {
              "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
              "items": {"enum": ["ACTUAL_32_ROOT_16_CLASS_SAMPLE_NOT_ATTESTED", "PROVIDER_LIVE_ATTESTATION_NOT_RUN", "NOT_A_RELEASE_CERTIFICATION"]}
            }
          }
        }
      }
    }
  }
}
