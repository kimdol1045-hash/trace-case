ARG PGVECTOR_IMAGE=pgvector/pgvector:0.8.1-pg16@sha256:33198da2828a14c30348d2ccb4750833d5ed9a44c88d840a0e523d7417120337
ARG APACHE_AGE_IMAGE=apache/age:release_PG16_1.6.0@sha256:16aa423d20a31aed36a3313244bf7aa00731325862f20ed584510e381f2feaed

FROM ${PGVECTOR_IMAGE} AS pgvector

FROM ${APACHE_AGE_IMAGE}

# The two upstream images are PostgreSQL 16 Debian builds. Copy only the
# pgvector extension artifacts into the AGE image so the rehearsal exercises
# LightRAG's real PGGraphStorage and PGVectorStorage against one auxiliary DB.
COPY --from=pgvector /usr/lib/postgresql/16/lib/vector.so /usr/lib/postgresql/16/lib/vector.so
COPY --from=pgvector /usr/share/postgresql/16/extension/vector.control /usr/share/postgresql/16/extension/vector.control
COPY --from=pgvector /usr/share/postgresql/16/extension/vector--*.sql /usr/share/postgresql/16/extension/
