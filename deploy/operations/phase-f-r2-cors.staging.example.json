{
  "rules": [
    {
      "allowed": {
        "origins": ["https://tc-stage.example.test"],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["content-type", "x-amz-meta-sha256"]
      },
      "exposeHeaders": [
        "etag",
        "content-length",
        "content-type",
        "x-amz-meta-sha256"
      ],
      "maxAgeSeconds": 300
    }
  ]
}
