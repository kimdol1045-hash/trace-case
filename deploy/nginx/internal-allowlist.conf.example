# Copy this file to /etc/nginx/tc/internal-allowlist.conf and replace the
# examples with the exact office/VPN egress CIDRs approved for the deployment.
# The loopback entries support host-local health checks only. The final deny is
# mandatory, so an unconfigured copy fails closed for remote clients.
allow 127.0.0.1/32;
allow ::1/128;
# allow 192.0.2.0/24;  # example only; replace with an approved internal CIDR
# allow 2001:db8::/48; # example only; replace with an approved VPN CIDR
deny all;
