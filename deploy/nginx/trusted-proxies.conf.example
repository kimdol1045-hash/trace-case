# Copy this file to /etc/nginx/tc/trusted-proxies.conf. Leaving it without any
# set_real_ip_from entry is the safe configuration when nginx is Internet- or
# VPN-facing directly. When a load balancer is in front, add only its exact
# source CIDRs so a client-supplied X-Forwarded-For value cannot bypass ACLs or
# per-client rate limits.
# set_real_ip_from 192.0.2.10/32; # example only; replace with the real LB CIDR
