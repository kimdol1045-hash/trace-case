# Credential-free default. Change to http only after every secret, scope, workspace,
# allowlist, and invited-channel check below is complete.
TC_SLACK_MODE=disabled
TC_SLACK_SIGNING_SECRET=
TC_SLACK_BOT_TOKEN=
TC_SLACK_WORKSPACE_ID=T_REPLACE_ME
TC_PUBLIC_SLACK_BASE_URL=https://slack-ingress.example.com
TC_SLACK_ALLOWLIST_CHANNEL_IDS=["C_REPLACE_ME"]
# Optional trusted product UI authority; omit to render replies without a link.
TC_PUBLIC_WEB_BASE_URL=
# Safe local defaults. Opening the breaker leaves durable intents queued/suppressed
# without making a provider write; no credential is included in these settings.
TC_SLACK_GENERATION_NOTIFICATIONS_ENABLED=false
TC_SLACK_NOTIFICATION_BREAKER_OPEN=false
TC_SLACK_NOTIFICATION_DELIVERY_LEASE_SECONDS=60
TC_SLACK_NOTIFICATION_RECONCILE_WINDOW_SECONDS=86400
TC_SLACK_NOTIFICATION_RETRY_BASE_SECONDS=5
TC_SLACK_NOTIFICATION_RETRY_MAX_SECONDS=3600
